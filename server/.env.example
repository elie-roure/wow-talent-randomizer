# Battle.net API credentials (client credentials flow).
# Create a client on https://develop.battle.net/access/clients
BNET_CLIENT_ID=your_client_id
BNET_CLIENT_SECRET=your_client_secret

# API region: eu, us, kr or tw
BNET_REGION=eu
# Default locale of talent names/descriptions
BNET_LOCALE=fr_FR

# Optional
# PORT=3000
# CACHE_DIR=./cache
# CACHE_TTL_HOURS=168
